# ── Gitea ───────────────────────────────────────────────────────────────────
# Internal URL: how the web container reaches Gitea (server-side). In docker
# compose this is overridden to http://gitea:3001 automatically.
GITEA_URL=http://localhost:3001
# Public URL: how a browser reaches Gitea (OIDC redirect, git source links).
GITEA_PUBLIC_URL=http://localhost:3001
GITEA_DOMAIN=localhost

# Change ALL of these in production
GITEA_SECRET_KEY=changeme_secret_key_32chars_min
GITEA_INTERNAL_TOKEN=changeme_internal_token_32chars
GITEA_JWT_SECRET=changeme_jwt_secret

GITEA_ADMIN_USER=hubadmin
GITEA_ADMIN_PASSWORD=hubadmin_changeme
GITEA_ADMIN_EMAIL=admin@example.com

# Set by bootstrap script; used by the web app to call Gitea for webhooks/reindex
# GITEA_ADMIN_TOKEN=<set after first docker compose up, see docs/SETUP.md>

# ── Hub config ──────────────────────────────────────────────────────────────
HUB_ORG=assets
HUB_ADMIN_TEAM=admins

# ── Web / Next.js ────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme_nextauth_secret_32chars

# ── OIDC (company identity provider) ────────────────────────────────────────
# For the demo profile: Gitea acts as the OIDC provider (issuer = GITEA_URL).
# For production: point these at your Keycloak / Okta / Entra / Google Workspace.
# The OIDC client (OIDC_CLIENT_ID / OIDC_CLIENT_SECRET) is created by bootstrap.sh
# in Gitea and printed to stdout. Copy the values here after first run.
OIDC_ISSUER=http://localhost:3001
OIDC_CLIENT_ID=ai-asset-hub-web
OIDC_CLIENT_SECRET=changeme_set_by_bootstrap

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=gitea_dev_password
